# Configuración privada del backend: mantener los valores reales fuera de Git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_EVIDENCE_BUCKET=delivery-evidence

# Orígenes exactos autorizados para llamadas desde el navegador.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Secretos de webhooks e integraciones (generar valores aleatorios por entorno).
CARRIER_WEBHOOK_SECRET=
INTEGRATION_SHARED_SECRET=

# Opcionales. En producción establecer NODE_ENV=production y usar HTTPS al frente.
NODE_ENV=development
VERSAND_BIND_HOST=127.0.0.1
VERSAND_OPERATOR_PORT=4001
VERSAND_BUYER_PORT=4002
